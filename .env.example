# 本地服务端口
VP_PORT=3000

# 运行时数据目录（登录会话、缓存、浏览器 profile）
VP_DATA_DIR=.data

# 浏览器选择：auto（默认，跟随系统默认浏览器）/ firefox / chrome / edge / chromium / brave / vivaldi
VP_BROWSER=auto

# 旧配置仍可用，优先级更高：channel（msedge / chrome / moz-firefox）或浏览器可执行文件路径
VP_BROWSER_CHANNEL=
VP_BROWSER_EXECUTABLE=

# 洛谷站点
VP_LUOGU_BASE=https://www.luogu.com.cn

# 日志级别
VP_LOG_LEVEL=info
